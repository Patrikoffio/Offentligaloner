# Kopiera till .env.local och fyll i värdena. .env.local är gitignorad –
# lägg ALDRIG riktiga hemligheter i den här filen.

# ── Supabase (eu-north-1) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (endast server-side – ALDRIG NEXT_PUBLIC) ─────────────────────────
# Nyckelläget (test/live) avgör vilket price-id som gäller, och de MÅSTE matcha:
#   sk_test_… → test-priset, sk_live_… → prod-priset.
# Stripe avvisar en korsning (test-price med live-nyckel och tvärtom).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Rapportpris 99 kr. Sätt id:t som matchar nyckelläget ovan:
#   test:  price_1TxA8uLNrfBYc0eao9U2Ob5T
#   prod:  price_1TxA62LNrfBYc0eaU0D2UG2A
# amount_sek på köp-raden kommer från RAPPORT_PRIS_SEK (=99) i lib/stripe.ts –
# håll konstanten och Stripe-priset i synk.
STRIPE_PRICE_ID=

# ── Postmark (transaktionsmejl) ──────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=no-reply@offentligaloner.se

# ── Sajt ─────────────────────────────────────────────────────────────────────
# Lokalt: http://localhost:3000 · Prod: https://offentligaloner.se
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VERCEL_OIDC_TOKEN hanteras automatiskt av Vercel CLI (vercel dev / env pull) –
# sätts inte manuellt.
